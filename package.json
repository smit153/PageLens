{
  "name": "pagelens",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev:extension": "pnpm --filter pagelens-extension dev",
    "build:extension": "pnpm --filter pagelens-extension build",
    "dev:proxy": "pnpm --filter pagelens-proxy dev",
    "build:proxy": "pnpm --filter pagelens-proxy build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}

# Vercel AI Gateway credentials for the evaluate() -> typesafe-ai/jev call.
# Create a key at: https://vercel.com/<your-team>/~/ai-gateway/api-keys
# Copy this file to .env.local and fill in the value for local `vercel dev`.
# For the deployed function, set the same variable in the Vercel project's
# Environment Variables settings instead.
AI_GATEWAY_API_KEY=

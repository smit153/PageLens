# Vercel AI Gateway credentials for the evaluate() -> typesafe-ai/jev call.
# Create a key at: https://vercel.com/<your-team>/~/ai-gateway/api-keys
# Copy this file to .env.local and fill in the value for local `vercel dev`.
# For the deployed function, set the same variable in the Vercel project's
# Environment Variables settings instead.
AI_GATEWAY_API_KEY=

# Upstash Redis, backing the rate limiter (proxy/lib/rate-limit.ts). Create a
# database from the Vercel Marketplace (Storage -> Upstash) or at
# https://console.upstash.com, then copy its REST credentials here and into the
# Vercel project's Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development escape hatch. The limiter fails CLOSED -- if it cannot reach
# Redis it refuses the request rather than letting model spend go unmetered --
# so running without the credentials above needs an explicit opt-out. Never set
# this in a deployed environment.
RATE_LIMIT_DISABLED=1
